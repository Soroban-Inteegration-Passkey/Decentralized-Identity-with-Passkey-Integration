# ========================================================
# Decentralized Identity API Gateway - Environment Configuration
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Frontend Client Origin (CORS & WebAuthn RP verification)
FRONTEND_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/decentralized-identity

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-with-high-entropy-secret
JWT_EXPIRES_IN=24h

# Stellar & Soroban RPC Configuration
# Available options: TESTNET, MAINNET, STANDALONE
STELLAR_NETWORK=TESTNET
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# Smart Contract IDs (Optional for backend simulation)
STELLAR_CONTRACT_IDENTITY_REGISTRY=
STELLAR_CONTRACT_SELECTIVE_DISCLOSURE=
