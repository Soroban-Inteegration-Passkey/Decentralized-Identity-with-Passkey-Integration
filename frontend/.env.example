# ========================================================
# Decentralized Identity Frontend - Environment Configuration
# ========================================================

# Backend API Gateway URL (or leave empty if relying on Vite proxy in development)
VITE_API_URL=http://localhost:3001

# Stellar Network Configuration
# Supported options: testnet, mainnet, standalone
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban Smart Contract IDs
# NOTE: Deploy your contracts via `npm run deploy:testnet` or `stellar contract deploy`
# to populate these values with your unique deployed WASM contract IDs on testnet.
#
# Note on testnet IDs:
# CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC is the built-in native XLM
# Stellar Asset Contract (SAC). Custom smart contracts have distinct 'C...' addresses.
VITE_STELLAR_CONTRACT_IDENTITY_REGISTRY=
VITE_STELLAR_CONTRACT_SELECTIVE_DISCLOSURE=
